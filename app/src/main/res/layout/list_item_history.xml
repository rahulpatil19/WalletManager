<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="transaction"
            type="com.patilapps.walletmanager.database.entities.DbTransaction" />

        <variable
            name="currency"
            type="String" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <RelativeLayout
            android:id="@+id/rl_category"
            setCategoryBackgroundColor="@{transaction.categoryColor}"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_category_circle_blank"
            android:padding="10dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/image_view_category"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:setCategoryImage="@{transaction.categoryIcon}"
                app:tint="@color/white"
                tools:src="@drawable/ic_apple_fruits" />

        </RelativeLayout>

        <TextView
            android:id="@+id/tv_category"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@{transaction.category}"
            android:textColor="@color/black"
            android:textSize="14sp"
            app:layout_constraintStart_toEndOf="@+id/rl_category"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Travel" />

        <TextView
            android:id="@+id/tv_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="4dp"
            android:setDateWithYear="@{transaction.date}"
            android:textSize="14sp"
            app:layout_constraintStart_toEndOf="@id/rl_category"
            app:layout_constraintTop_toBottomOf="@+id/tv_category"
            tools:text="20 July, 2020" />

        <TextView
            android:id="@+id/tv_currency"
            setCurrency="@{currency}"
            setTransactionSymbol="@{transaction.type}"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="4dp"
            android:fontFamily="@font/nunito_semibold"
            android:textColor="@color/black"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="@id/tv_amount"
            app:layout_constraintEnd_toStartOf="@id/tv_amount"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="+$" />

        <TextView
            android:id="@+id/tv_amount"
            setAmount="@{transaction.amount}"
            setColor="@{transaction.type}"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/nunito_semibold"
            android:gravity="end"
            android:textColor="@color/green"
            android:textSize="18sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="2,000" />

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="4dp"
            android:fontFamily="@font/nunito_semibold"
            android:text="@{transaction.title}"
            android:textColor="@color/black"
            android:textSize="18sp"
            app:layout_constraintEnd_toStartOf="@id/button_delete"
            app:layout_constraintStart_toEndOf="@id/rl_category"
            app:layout_constraintTop_toBottomOf="@+id/tv_date"
            tools:text="Payment done at Kirana store asj akjs jqdmklj" />


        <ImageView
            android:id="@+id/button_delete"
            android:layout_width="24dp"
            android:layout_height="24dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:srcCompat="@drawable/ic_baseline_delete_24"
            app:tint="@color/gray_dark" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>