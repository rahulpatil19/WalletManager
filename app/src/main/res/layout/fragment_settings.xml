<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:background="@color/white"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_height="wrap_content">

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:title="Settings" />

        </com.google.android.material.appbar.AppBarLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:padding="16dp"
                    android:visibility="gone"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:src="@drawable/ic_baseline_language_24"
                        android:layout_width="24dp"
                        android:layout_height="24dp"/>

                    <TextView
                        android:layout_marginStart="16dp"
                        android:text="@string/text_language"
                        android:textColor="@color/black"
                        android:layout_width="0dp"
                        android:textSize="18sp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"/>

                </LinearLayout>


                <LinearLayout
                    android:id="@+id/layout_settings_change_currency"
                    android:padding="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:src="@drawable/ic_baseline_trending_down_24"
                        android:layout_width="24dp"
                        android:layout_height="24dp"/>

                    <TextView
                        android:layout_marginStart="16dp"
                        android:text="@string/text_change_currency"
                        android:textColor="@color/black"
                        android:layout_width="0dp"
                        android:textSize="18sp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"/>


                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layout_settings_delete_all"
                    android:padding="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:src="@drawable/ic_baseline_delete_24"
                        android:layout_width="24dp"
                        android:layout_height="24dp"/>

                    <TextView
                        android:layout_marginStart="16dp"
                        android:text="@string/text_delete_all_transactions"
                        android:textColor="@color/black"
                        android:layout_width="0dp"
                        android:textSize="18sp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"/>


                </LinearLayout>


                <LinearLayout
                    android:padding="16dp"
                    android:id="@+id/layout_settings_rate_us"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:src="@drawable/ic_baseline_rate_review_24"
                        android:layout_width="24dp"
                        android:layout_height="24dp"/>

                    <TextView
                        android:layout_marginStart="16dp"
                        android:text="@string/text_rate_us"
                        android:textColor="@color/black"
                        android:layout_width="0dp"
                        android:textSize="18sp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"/>

                </LinearLayout>

                <LinearLayout
                    android:visibility="gone"
                    android:padding="16dp"
                    android:id="@+id/layout_settings_privacy"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:src="@drawable/ic_baseline_policy_24"
                        android:layout_width="24dp"
                        android:layout_height="24dp"/>

                    <TextView
                        android:layout_marginStart="16dp"
                        android:text="@string/text_privacy_policy"
                        android:textColor="@color/black"
                        android:layout_width="0dp"
                        android:textSize="18sp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"/>

                </LinearLayout>

                <LinearLayout
                    android:padding="16dp"
                    android:id="@+id/layout_settings_about"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:src="@drawable/ic_baseline_info_24"
                        android:layout_width="24dp"
                        android:layout_height="24dp"/>

                    <TextView
                        android:layout_marginStart="16dp"
                        android:text="@string/text_about"
                        android:textColor="@color/black"
                        android:layout_width="0dp"
                        android:textSize="18sp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"/>

                </LinearLayout>
            </LinearLayout>


            <TextView
                android:padding="16dp"
                android:gravity="center"
                android:layout_centerHorizontal="true"
                android:text="@string/info_version"
                android:layout_alignParentBottom="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

        </RelativeLayout>

    </LinearLayout>
</layout>