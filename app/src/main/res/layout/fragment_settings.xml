<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:title="Settings" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:padding="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:src="@drawable/ic_baseline_language_24"
                        android:layout_width="28dp"
                        android:layout_height="28dp"/>

                    <TextView
                        android:layout_marginStart="16dp"
                        android:text="Language"
                        android:textColor="@color/black"
                        android:layout_width="0dp"
                        android:textSize="20sp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"/>

                    <ImageView
                        android:src="@drawable/ic_arrow_carrot_right"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                </LinearLayout>

                <LinearLayout
                    android:padding="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:src="@drawable/ic_baseline_trending_down_24"
                        android:layout_width="28dp"
                        android:layout_height="28dp"/>

                    <TextView
                        android:layout_marginStart="16dp"
                        android:text="Change Currency"
                        android:textColor="@color/black"
                        android:layout_width="0dp"
                        android:textSize="20sp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"/>

                    <ImageView
                        android:src="@drawable/ic_arrow_carrot_right"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                </LinearLayout>

                <LinearLayout
                    android:padding="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:src="@drawable/ic_baseline_rate_review_24"
                        android:layout_width="28dp"
                        android:layout_height="28dp"/>

                    <TextView
                        android:layout_marginStart="16dp"
                        android:text="Rate us"
                        android:textColor="@color/black"
                        android:layout_width="0dp"
                        android:textSize="20sp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"/>

                    <ImageView
                        android:src="@drawable/ic_arrow_carrot_right"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                </LinearLayout>

                <LinearLayout
                    android:padding="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:src="@drawable/ic_baseline_policy_24"
                        android:layout_width="28dp"
                        android:layout_height="28dp"/>

                    <TextView
                        android:layout_marginStart="16dp"
                        android:text="Privacy Policy"
                        android:textColor="@color/black"
                        android:layout_width="0dp"
                        android:textSize="20sp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"/>

                    <ImageView
                        android:src="@drawable/ic_arrow_carrot_right"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                </LinearLayout>

                <LinearLayout
                    android:padding="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:src="@drawable/ic_baseline_info_24"
                        android:layout_width="28dp"
                        android:layout_height="28dp"/>

                    <TextView
                        android:layout_marginStart="16dp"
                        android:text="About us"
                        android:textColor="@color/black"
                        android:layout_width="0dp"
                        android:textSize="20sp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"/>

                    <ImageView
                        android:src="@drawable/ic_arrow_carrot_right"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                </LinearLayout>
            </LinearLayout>


            <TextView
                android:padding="16dp"
                android:gravity="center"
                android:layout_centerHorizontal="true"
                android:text="@string/info_version"
                android:layout_alignParentBottom="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

        </RelativeLayout>

    </LinearLayout>
</layout>