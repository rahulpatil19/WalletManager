<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            app:title="Wallet"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <ImageView
            android:layout_marginTop="16dp"
            android:id="@+id/image_arrow_left"
            app:layout_constraintTop_toBottomOf="@id/toolbar"
            app:layout_constraintStart_toStartOf="parent"
            android:src="@drawable/ic_arrow_carrot_left"
            android:padding="8dp"
            android:layout_width="48dp"
            android:layout_height="48dp"/>

        <TextView
            android:text="2021"
            android:id="@+id/tv_year"
            android:fontFamily="@font/nunito_bold"
            android:textSize="20sp"
            android:textColor="@color/primary_variant"
            app:layout_constraintTop_toBottomOf="@id/toolbar"
            app:layout_constraintStart_toEndOf="@id/image_arrow_left"
            app:layout_constraintEnd_toStartOf="@id/image_arrow_right"
            android:layout_marginTop="16dp"
            app:layout_constraintBottom_toBottomOf="@id/image_arrow_left"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <ImageView
            android:layout_marginTop="16dp"
            android:id="@+id/image_arrow_right"
            app:layout_constraintTop_toBottomOf="@id/toolbar"
            app:layout_constraintEnd_toEndOf="parent"
            android:src="@drawable/ic_arrow_carrot_right"
            android:layout_width="48dp"
            android:padding="8dp"
            android:layout_height="48dp"/>

        <TextView
            android:id="@+id/tv_overview_title"
            android:layout_marginStart="16dp"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/tv_year"
            app:layout_constraintStart_toStartOf="parent"
            android:text="Spending Overview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <ImageView
            android:id="@+id/iv_chart"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_overview_title"
            android:src="@drawable/ic_home_black"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_width="wrap_content"
            android:layout_height="200dp"/>

        <TextView
            android:text="Categories"
            android:textSize="16sp"
            android:textStyle="bold"
            android:id="@+id/tv_category_title"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/iv_chart"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <androidx.recyclerview.widget.RecyclerView
            app:layout_constraintTop_toBottomOf="@id/tv_category_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintStart_toEndOf="parent"
            android:id="@+id/list_transaction_by_category"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>