<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="searchViewModel"
            type="com.patilapps.walletmanager.screens.search.SearchViewModel" />

    </data>


    <RelativeLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appBar"
            android:layout_width="match_parent"
            android:backgroundTint="@color/white"
            android:layout_height="wrap_content">


            <com.google.android.material.appbar.MaterialToolbar
                android:layout_width="match_parent"
                app:contentInsetStartWithNavigation="0dp"
                android:id="@+id/toolbar"
                app:navigationIcon="@drawable/ic_arrow_carrot_left"
                android:layout_height="wrap_content">


                <androidx.appcompat.widget.SearchView
                    android:backgroundTint="@color/white"
                    android:id="@+id/search_view"
                    app:queryHint="@string/hint_search"
                    android:focusableInTouchMode="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />


            </com.google.android.material.appbar.MaterialToolbar>

        </com.google.android.material.appbar.AppBarLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:layout_below="@+id/appBar"
            android:layout_marginTop="16dp"
            android:id="@+id/list_item_search"
            android:layout_width="match_parent"
            android:orientation="vertical"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            android:layout_height="match_parent" />


        <LinearLayout
            android:id="@+id/layout_no_transaction"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="16dp"
            android:setEmptyLayoutVisibility="@{searchViewModel.result}">

            <ImageView
                android:id="@+id/imageView"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@drawable/empty_opened_wallet"
                app:tint="@color/primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="No transaction found" />

        </LinearLayout>

        <ProgressBar
            android:setSearchProgress="@{searchViewModel.result}"
            android:id="@+id/progress_bar"
            android:layout_centerInParent="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

    </RelativeLayout>
</layout>