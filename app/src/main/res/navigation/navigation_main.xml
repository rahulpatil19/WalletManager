<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/navigation_main"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.patilapps.walletmanager.screens.home.HomeFragment"
        android:label="HomeFragment">
        <action
            android:id="@+id/action_homeFragment_to_chooseTransactionSheetFragment"
            app:destination="@id/chooseTransactionSheetFragment" />
        <action
            android:id="@+id/action_homeFragment_to_allTransactionFragment"
            app:destination="@id/allTransactionFragment"
            app:launchSingleTop="true" />
        <action
            android:id="@+id/action_homeFragment_to_statisticFragment"
            app:destination="@id/statisticFragment" />
        <action
            android:id="@+id/action_homeFragment_to_settingsFragment"
            app:destination="@id/settingsFragment" />
        <action
            android:id="@+id/action_homeFragment_to_searchFragment"
            app:destination="@id/searchFragment" />
        <action
            android:id="@+id/action_homeFragment_to_updateTransactionFragment"
            app:destination="@id/updateTransactionFragment" />
    </fragment>

    <dialog
        android:id="@+id/chooseTransactionSheetFragment"
        android:name="com.patilapps.walletmanager.screens.home.ChooseTransactionSheetFragment"
        android:label="ChooseTransactionSheetFragment" >
        <action
            android:id="@+id/action_chooseTransactionSheetFragment_to_createFragment"
            app:destination="@id/createFragment" />
    </dialog>
    <fragment
        android:id="@+id/allTransactionFragment"
        android:name="com.patilapps.walletmanager.screens.transactions.TransactionFragment"
        android:label="AllTransactionFragment">
        <action
            android:id="@+id/action_allTransactionFragment_to_monthDataFragment"
            app:destination="@id/monthDataFragment" />
        <action
            android:id="@+id/action_allTransactionFragment_to_updateTransactionFragment"
            app:destination="@id/updateTransactionFragment" />

    </fragment>
    <fragment
        android:id="@+id/statisticFragment"
        android:name="com.patilapps.walletmanager.screens.statistic.StatisticFragment"
        android:label="StatisticFragment" >
        <action
            android:id="@+id/action_statisticFragment_to_monthDataFragment"
            app:destination="@id/monthDataFragment" />
    </fragment>
    <fragment
        android:id="@+id/monthDataFragment"
        android:name="com.patilapps.walletmanager.screens.monthlydata.MonthDataFragment"
        android:label="MonthDataFragment" >
        <argument
            android:name="statistic"
            app:argType="com.patilapps.walletmanager.domain.Statistics" />
        <argument
            android:name="year"
            app:argType="integer" />
        <action
            android:id="@+id/action_monthDataFragment_to_updateTransactionFragment"
            app:destination="@id/updateTransactionFragment"
            app:popUpToInclusive="false" />
    </fragment>
    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.patilapps.walletmanager.screens.settings.SettingsFragment"
        android:label="SettingsFragment" >
        <action
            android:id="@+id/action_settingsFragment_to_aboutSheetFragment"
            app:destination="@id/aboutSheetFragment" />
        <action
            android:id="@+id/action_settingsFragment_to_currencySheetFragment"
            app:destination="@id/currencySheetFragment" />
    </fragment>
    <dialog
        android:id="@+id/aboutSheetFragment"
        android:name="com.patilapps.walletmanager.screens.settings.AboutSheetFragment"
        android:label="AboutSheetFragment" />
    <fragment
        android:id="@+id/currencySheetFragment"
        android:name="com.patilapps.walletmanager.screens.settings.CurrencySheetFragment"
        android:label="CurrencySheetFragment" />
    <fragment
        android:id="@+id/searchFragment"
        android:name="com.patilapps.walletmanager.screens.search.SearchFragment"
        android:label="SearchFragment" >
        <action
            android:id="@+id/action_searchFragment_to_updateTransactionFragment"
            app:destination="@id/updateTransactionFragment" />
    </fragment>
    <fragment
        android:id="@+id/updateTransactionFragment"
        android:name="com.patilapps.walletmanager.screens.update.UpdateTransactionFragment"
        android:label="UpdateTransactionFragment" >
        <argument
            android:name="transaction"
            app:argType="com.patilapps.walletmanager.domain.Transaction" />
        <action
            android:id="@+id/action_updateTransactionFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/homeFragment"
            app:popUpToInclusive="true" />
        <argument android:name="navigatedFrom"
            app:argType="string"
            android:defaultValue="transaction" />
        <action
            android:id="@+id/action_updateTransactionFragment_to_statisticFragment"
            app:destination="@id/statisticFragment"
            app:popUpTo="@id/statisticFragment"
            app:popUpToInclusive="true" />
    </fragment>
    <fragment
        android:id="@+id/createFragment"
        android:name="com.patilapps.walletmanager.screens.create.CreateFragment"
        android:label="CreateFragment" >
        <argument
            android:name="transactionType"
            app:argType="string" />
    </fragment>


</navigation>