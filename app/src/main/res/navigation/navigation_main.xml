<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/navigation_main"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.walletmanager.app.screens.home.HomeFragment"
        android:label="HomeFragment">
        <action
            android:id="@+id/action_homeFragment_to_chooseTransactionSheetFragment"
            app:destination="@id/chooseTransactionSheetFragment" />
        <action
            android:id="@+id/action_homeFragment_to_allTransactionFragment"
            app:destination="@id/allTransactionFragment" />
        <action
            android:id="@+id/action_homeFragment_to_walletFragment"
            app:destination="@id/walletFragment" />
        <action
            android:id="@+id/action_homeFragment_to_statisticFragment"
            app:destination="@id/statisticFragment" />
        <action
            android:id="@+id/action_homeFragment_to_settingsFragment"
            app:destination="@id/settingsFragment" />
        <action
            android:id="@+id/action_homeFragment_to_updateTransactionActivity"
            app:destination="@id/updateTransactionActivity" />
    </fragment>

    <activity
        android:id="@+id/transactionActivity"
        android:name="com.walletmanager.app.screens.create.AddTransactionActivity"
        android:label="activity_transaction"
        tools:layout="@layout/activity_add_transaction">
        <argument
            android:name="transactionType"
            app:argType="string"
            android:defaultValue="expense" />
    </activity>
    <dialog
        android:id="@+id/chooseTransactionSheetFragment"
        android:name="com.walletmanager.app.screens.home.ChooseTransactionSheetFragment"
        android:label="ChooseTransactionSheetFragment" >
        <action
            android:id="@+id/action_chooseTransactionSheetFragment_to_transactionActivity"
            app:destination="@id/transactionActivity"
            app:popUpTo="@id/homeFragment" />
    </dialog>
    <fragment
        android:id="@+id/allTransactionFragment"
        tools:layout="@layout/fragment_all_transaction"
        android:name="com.walletmanager.app.screens.transactions.TransactionFragment"
        android:label="AllTransactionFragment" >
        <action
            android:id="@+id/action_allTransactionFragment_to_monthDataFragment"
            app:destination="@id/monthDataFragment" />
        <action
            android:id="@+id/action_allTransactionFragment_to_updateTransactionActivity"
            app:destination="@id/updateTransactionActivity" />
        <action
            android:id="@+id/action_allTransactionFragment_to_homeFragment"
            app:destination="@id/homeFragment" />

    </fragment>
    <fragment
        android:id="@+id/walletFragment"
        android:name="com.walletmanager.app.screens.wallet.WalletFragment"
        android:label="WalletFragment">
        <action
            android:id="@+id/action_walletFragment_to_walletFilterSheetFragment"
            app:destination="@id/walletFilterSheetFragment" />
    </fragment>
    <fragment
        android:id="@+id/statisticFragment"
        android:name="com.walletmanager.app.screens.statistic.StatisticFragment"
        android:label="StatisticFragment" />
    <fragment
        android:id="@+id/monthDataFragment"
        android:name="com.walletmanager.app.screens.monthlydata.MonthDataFragment"
        android:label="MonthDataFragment" />
    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.walletmanager.app.screens.settings.SettingsFragment"
        android:label="SettingsFragment" >
        <action
            android:id="@+id/action_settingsFragment_to_aboutSheetFragment"
            app:destination="@id/aboutSheetFragment" />
        <action
            android:id="@+id/action_settingsFragment_to_currencySheetFragment"
            app:destination="@id/currencySheetFragment" />
    </fragment>
    <dialog
        android:id="@+id/aboutSheetFragment"
        android:name="com.walletmanager.app.screens.settings.AboutSheetFragment"
        android:label="AboutSheetFragment" />
    <fragment
        android:id="@+id/currencySheetFragment"
        android:name="com.walletmanager.app.screens.settings.CurrencySheetFragment"
        android:label="CurrencySheetFragment" />
    <activity
        android:id="@+id/updateTransactionActivity"
        android:name="com.walletmanager.app.screens.update.UpdateTransactionActivity"
        android:label="UpdateTransactionActivity" >
        <argument
            android:name="transaction"
            app:argType="com.walletmanager.app.domain.Transaction" />
    </activity>


</navigation>